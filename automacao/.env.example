# ===== Shopee Affiliate Open API (mesmas da vitrine) =====
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
# subId dos links gerados aqui: no relatório da Shopee você vê as vendas que vieram dos carrosséis
SHOPEE_SUB_ID=insta

# ===== Supabase (mesmo projeto da vitrine) =====
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ===== Filtros da escolha =====
MIN_COMISSAO=10          # % mínima de comissão
MIN_NOTA=4.6
MIN_VENDAS=1000
PRECO_MIN=15
PRECO_MAX=200
PAGINAS=3                # páginas de 50 produtos lidas por dia
# Uma palavra por dia, em rodízio (vazio = todos os produtos)
PALAVRAS_CHAVE=skincare,cozinha,organizador,maquiagem,casa,acessorios femininos
# Produtos com essas palavras no nome são ignorados
PALAVRAS_BLOQUEADAS=emagrecedor,remedio,suplemento,arma,adulto
FIXAR_NO_TOPO=sim        # "nao" para não colocar o achado em destaque na vitrine

# ===== Carrossel =====
INSTAGRAM_HANDLE=@seuperfil
# Estilo fixo (vazio = automático pela categoria): beleza, casa, moda, tech, pet, infantil, fitness, padrao
ESTILO=
PASTA_SAIDA=./saida
# Opcional: textos com IA (gancho e destaques). Sem a chave, usa textos padrão.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ===== Opcional: prévia no Telegram =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Opcional: postar sozinho (Graph API da Meta) =====
POSTAR=                  # instagram,facebook  (vazio = não posta)
META_PAGE_TOKEN=         # token da Página (que não expira)
META_PAGE_ID=
META_IG_USER_ID=         # id da conta do Instagram ligada à Página
